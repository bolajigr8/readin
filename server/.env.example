# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8081

# ── MongoDB Atlas (cloud.mongodb.com) ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/readin?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars

# ── Google OAuth (console.cloud.google.com) ───────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Email — Resend (resend.com — free: 3,000 emails/month) ───────────────────
# To swap provider: implement IEmailProvider and update email.service.ts
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=ReadIn <noreply@yourdomain.com>
APP_URL=http://localhost:5000

# ── Cloudinary (cloudinary.com — free: 25 credits/month) ─────────────────────
# Folders: readin/originals | readin/converted | readin/covers
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Upstash Redis (upstash.com — free: 10,000 commands/day) ──────────────────
UPSTASH_REDIS_URL=redis://:your_password@your-endpoint.upstash.io:6379

# ── Conversion ────────────────────────────────────────────────────────────────
TEMP_DIR=/tmp
MAX_CONVERSION_CONCURRENT=2

# ── RevenueCat (revenuecat.com) ───────────────────────────────────────────────
# Paste this value as the webhook Authorization secret in the RevenueCat dashboard
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GENERAL=200
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_UPLOAD=20